# Copy to .env (never committed) or set these as deployment secrets.

# Shared code team members enter to sign in. Use a passphrase, not a word.
TEAM_ACCESS_CODE=
# Password for /admin, where orders are approved and shipped.
ADMIN_PASSWORD=

# Optional. Comma-separated email domains allowed to sign in.
TEAM_EMAIL_DOMAINS=tropicaldistillery.com

# Optional. Postgres connection string. When set, orders are stored in the
# database instead of DATA_DIR — required on hosts without a persistent disk
# (Replit deployments included). Run `npm install` once to fetch the driver.
DATABASE_URL=

# Optional. Slack incoming webhook (or Zapier/Make URL) told about every new
# order and status change.
ORDER_WEBHOOK_URL=

# Optional. Defaults shown.
PORT=4100
DATA_DIR=./data
ORDER_PREFIX=TD
TIMEZONE=America/New_York
