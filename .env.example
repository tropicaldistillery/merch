# Copy to .env (never committed) or set these as deployment secrets.

# Shared code team members enter to sign in. Use a passphrase, not a word.
TEAM_ACCESS_CODE=
# Password for /admin, where orders are approved and shipped.
ADMIN_PASSWORD=

# Optional. Comma-separated email domains allowed to sign in.
TEAM_EMAIL_DOMAINS=tropicaldistillery.com

# Optional. Postgres connection string. When set, orders are stored in the
# database instead of DATA_DIR — required on hosts without a persistent disk
# (Replit deployments included). Run `npm install` once to fetch the driver.
DATABASE_URL=

# Optional. Slack incoming webhook (or Zapier/Make URL) told about every new
# order and status change.
ORDER_WEBHOOK_URL=

# Optional. Order emails through Resend: an alert to ORDER_EMAIL_TO for every
# new order, and confirmations and status updates to whoever placed it.
# ORDER_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Tropical Distillery Merch <merch@tropicaldistillery.com>
ORDER_EMAIL_TO=
# Optional: split the new-order alerts. Samples (the Samples category) go to
# ORDER_EMAIL_TO_SAMPLES and everything else, the point-of-sale items, to
# ORDER_EMAIL_TO_POS; an order with both is split, each inbox getting just
# its own lines. Either one left empty falls back to ORDER_EMAIL_TO.
ORDER_EMAIL_TO_POS=
ORDER_EMAIL_TO_SAMPLES=
# Optional: people copied (cc) on those alerts, comma-separated. CC_POS and
# CC_SAMPLES go with their inbox's alerts; ORDER_EMAIL_CC is copied on any
# admin alert without a cc list of its own.
ORDER_EMAIL_CC_POS=
ORDER_EMAIL_CC_SAMPLES=
ORDER_EMAIL_CC=
# The site's address, so emails can link to the store.
PUBLIC_URL=

# Optional. Defaults shown.
PORT=4100
DATA_DIR=./data
ORDER_PREFIX=TD
TIMEZONE=America/New_York
